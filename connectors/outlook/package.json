{
  "name": "@dxheroes/mcp-outlook",
  "version": "0.1.1",
  "private": true,
  "description": "Outlook mail and calendar MCP endpoints for personal and work Microsoft accounts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "mcpPackage": true,
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src __tests__",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "outlook",
    "microsoft",
    "graph"
  ],
  "author": "DX Heroes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DXHeroes/mcp-servers.git",
    "directory": "connectors/outlook"
  },
  "dependencies": {
    "zod": "4.6.6",
    "@dxheroes/mcp-kit": "workspace:*",
    "@dxheroes/mcp-runtime": "workspace:*",
    "@dxheroes/mcp-graph": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@modelcontextprotocol/client": "2.4.0"
  },
  "bin": {
    "mcp-outlook": "./dist/cli.js"
  }
}
