{
  "name": "@dxheroes/mcp-merk",
  "version": "0.1.1",
  "private": true,
  "description": "MCP server for Merk API \u2014 Czech and Slovak company data, financials, relations, employees, fleet, and more",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "mcpPackage": true,
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src __tests__",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "merk",
    "company-data",
    "czech",
    "slovak",
    "financials",
    "mcp-connector"
  ],
  "author": "DX Heroes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DXHeroes/mcp-servers.git",
    "directory": "connectors/merk"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@dxheroes/mcp-kit": "workspace:*",
    "@dxheroes/mcp-runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "bin": {
    "mcp-merk": "./dist/cli.js"
  }
}
