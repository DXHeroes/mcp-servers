FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
RUN apk add --no-cache --upgrade python3=3.14.7-r1 py3-pip=26.1.2-r0 libcrypto3=3.5.8-r0 libssl3=3.5.8-r0
WORKDIR /source
RUN corepack enable && corepack prepare pnpm@10.32.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm build \
 && pnpm --filter @dxheroes/mcp-bundle deploy --legacy --prod /app \
 && for id in abra-flexi byzdata fakturoid gemini-deep-research merk postgres toggl; do pnpm --filter "@dxheroes/mcp-$id" deploy --legacy --prod "/opt/connectors/$id"; done
RUN python3 -m venv --without-pip /opt/venvs/python-fixture \
 && python3 -m pip --python /opt/venvs/python-fixture/bin/python install --only-binary=:all: --require-hashes --no-cache-dir -r /app/fixtures/requirements.lock

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
RUN apk add --no-cache --upgrade python3=3.14.7-r1 tini=0.19.0-r3 libcrypto3=3.5.8-r0 libssl3=3.5.8-r0 \
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/pnpm /usr/local/bin/pnpx
COPY --from=build /app /app
COPY --from=build /opt/connectors /opt/connectors
COPY --from=build /opt/venvs/python-fixture /opt/venvs/python-fixture
WORKDIR /app
USER 65532:65532
ENV NODE_ENV=production MCP_PORT=8080 MCP_BUNDLE_MANIFEST=/app/fixtures/bundle.json PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
ENTRYPOINT ["/sbin/tini", "--", "node", "dist/cli.js"]
